            "minLength": 0,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          },
          "conPassword": {
            "type": "string"
          }
        }
      },
      "ResendEmailDto": {
